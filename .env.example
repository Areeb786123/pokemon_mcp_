# stdio for local MCP clients, streamable-http to host the server
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
LOG_LEVEL=INFO

POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT_SECONDS=10

# Set these when the HTTP server is exposed beyond localhost
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# MCP_ALLOWED_ORIGINS=http://localhost:*
